               .segment begin "Task: Capacitive Touch"
               capacitiveTouch/initialize:
               ;? // Clamp all capactive touch pins to ground
               ;? for (U16 n = 0; n < PIN_COUNT; n++) {
011d ---- 0000                         ld          R0, #0
               /id0293:
               ;?     isrcClamp(cfg.pAuxioAxdCapTouch[n]);
011e ---- 50bb                             ld          R5, #(capacitiveTouch/cfg/pAuxioAxdCapTouch + 0)
011f ---- ff1d                             ld          R7, [R5+R0]
0120 ---- 4492                             iobclr      #0, [#IOP_ANAIF_ISRCCTL]
0121 ---- 16d5                             jsr         gpioClearOutput
               ;? }
0122 ---- 8801                         add         R0, #1
0123 ---- 8a02                         cmp         R0, #2
0124 ---- aef9                         bltu        /id0293
               ;?
               ;? // Do not drive the reference high
               ;? gpioClearOutput(AUXIO_AXS_CAP_TOUCH_REF);
0125 ---- 45bd                         iobclr      #(25 & 0x7), [#(IOP_AIODIO0_GPIODOUT + (25 >> 3))]
               ;?
               ;? // Schedule the first execution
               ;? evhSetupTimer1Trigger(0, 1, 5);
