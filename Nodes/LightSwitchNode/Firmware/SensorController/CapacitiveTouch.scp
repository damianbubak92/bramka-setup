    <task name="Capacitive Touch">
        <desc><![CDATA[Samples the capacitive touch buttons on the ULP Sense BoosterPack., using the COMPA, ISRC and TDC peripherals, and performs touch detection.

The following is performed for each touch area:
- The ISRC peripheral is used to charge the touch area to 0.6 V, which generates a rising edge on the COMPA output. The COMPA reference is then changed to 2.4 V (with a temporary boost to 3.3 V), and charging continues until a second rising edge occurs on the COMPA output.
- The TDC is used to measure the time between these two COMPA output rising edges. The TDC value is used by the touch detection algorithm.
- To filter out noise, such as 50/60 Hz, the touch detection algorithm works on the average value of the N last TDC values.
- While touch is not detected, a baseline value is updated slowly. While touch is detected, a high value is updated.
- The touch detection threshold is in the middle between the high value and the baseline value.

The sample rate is increased while touch is detected on one or more touch areas.

The System CPU application is notified for each task iteration during touch detection, and one time when touch detection ends.

Task Testing should only be used for debugging purposes, as it will not run the Capacitive Touch task at the correct rate. Use Run-Time Logging for testing, performance evaluation and tuning.

BOOSTXL-ULPSENSE SETUP:
- Make sure that the supplied plexiglass is securely mounted over the capacitive touch buttons, without any air gaps.
- Remove all jumpers]]></desc>
        <tattr name="BASELINE_UPDATE_PERIOD" desc="Baseline update period when not touching" type="dec" content="const" scope="task" min="0" max="65535">32</tattr>
        <tattr name="D_ISRC_CURRENT" desc="Default ISRC current = 1 uA (BV_ISRC_CURR_1P0U)" type="expr_hex" content="const" scope="task" min="0" max="65535">17</tattr>
        <tattr name="D_MAX_SMPL_PERIOD" desc="Default maximum sample period" type="dec" content="const" scope="task" min="0" max="65535">128</tattr>
        <tattr name="D_MIN_SMPL_PERIOD" desc="Default minimum sample period" type="dec" content="const" scope="task" min="0" max="65535">40</tattr>
        <tattr name="LOW_MEAN_IIR_DIV_EXP" desc="Division exponent for IIR filter of mean value of the low-mean window" type="dec" content="const" scope="task" min="0" max="65535">2</tattr>
        <tattr name="LOW_MEAN_IIR_UPDATE_PERIOD" desc="Update period of IIR filter of mean value of the low-mean window" type="expr" content="const" scope="task" min="0" max="65535">TDC_SMPL_WINDOW_SIZE * LOW_MEAN_WINDOW_SIZE</tattr>
        <tattr name="LOW_MEAN_WINDOW_EXP" desc="Exponent that determines LOW_MEAN_WINDOW_SIZE" type="dec" content="const" scope="task" min="0" max="65535">3</tattr>
        <tattr name="LOW_MEAN_WINDOW_SIZE" desc="Number of low mean values stored for each pin" type="expr" content="const" scope="task" min="0" max="65535">1 &lt;&lt; LOW_MEAN_WINDOW_EXP</tattr>
        <tattr name="LOW_MEAN_WINDOW_TOTAL" desc="Total size of the low mean window array variable" type="expr" content="const" scope="task" min="0" max="65535">LOW_MEAN_WINDOW_SIZE * PIN_COUNT</tattr>
        <tattr name="MAX_TDC_TIMEOUTS" desc="Maximum number of TDC timeouts before a pin is regarded as stuck" type="dec" content="const" scope="task" min="0" max="65535">5</tattr>
        <tattr name="MAX_TOUCH_ITERATIONS" type="expr" content="const" scope="task" min="0" max="65535">1500</tattr>
        <tattr name="PIN_COUNT" desc="Capactive touch pin count" type="expr" content="const" scope="task" min="0" max="8">'Analog Open-Drain Pins/Capacitive touch area/Pin count'</tattr>
        <tattr name="TDC_SMPL_WINDOW_EXP" desc="Exponent that determines TDC_SMPL_WINDOW_SIZE" type="dec" content="const" scope="task" min="0" max="65535">3</tattr>
        <tattr name="TDC_SMPL_WINDOW_SIZE" desc="Number of last TDC values stored per pin" type="expr" content="const" scope="task" min="0" max="65535">1 &lt;&lt; TDC_SMPL_WINDOW_EXP</tattr>
        <tattr name="TDC_SMPL_WINDOW_TOTAL" desc="Total size of the TDC sample window array variable" type="expr" content="const" scope="task" min="0" max="65535">TDC_SMPL_WINDOW_SIZE * PIN_COUNT</tattr>
        <tattr name="TOUCH_DETECT_OFFSET" type="expr" content="const" scope="task" min="0" max="65535">12</tattr>
        <tattr name="TOUCH_RELEASE_OFFSET" type="expr" content="const" scope="task" min="0" max="65535">6</tattr>
        <tattr name="cfg.isrcCurrent" desc="ISRC current used to charge the touch areas (logical OR of BV_ISRC_CURR_XYZ constants)" type="expr_hex" content="struct" scope="task" min="0" max="65535">D_ISRC_CURRENT</tattr>
        <tattr name="cfg.maxSmplPeriod" desc="Maximum sample period [0.25 ms]" type="expr" content="struct" scope="task" min="0" max="65535">D_MAX_SMPL_PERIOD</tattr>
        <tattr name="cfg.minSmplPeriod" desc="Minimum sample period [0.25 ms]" type="expr" content="struct" scope="task" min="0" max="65535">D_MIN_SMPL_PERIOD</tattr>
        <tattr name="output.bvTdcTimeout" desc="Indicates TDC timeout error, one bit for each pin" type="hex" content="struct" scope="task" min="0000" max="ffff">0000</tattr>
        <tattr name="output.bvTdcValueOverflow" desc="Indicates TDC value overflow error, one bit for each pin" type="hex" content="struct" scope="task" min="0000" max="ffff">0000</tattr>
        <tattr name="output.pBaselineValue" desc="For observation, for each pin: Baseline value" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="-32768" max="32767">0</tattr>
        <tattr name="output.pHighValue" desc="For observation, for each pin: High value" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="-32768" max="32767">0</tattr>
        <tattr name="output.pTdcSmplWindowMean" desc="For observation, for each pin: Mean value of the TDC sample window" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="output.pTdcValueRaw" desc="For observation, for each pin: Unfiltered TDC value" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="output.pThresValue" desc="For observation, for each pin: Touch threshold value" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="-32768" max="32767">0</tattr>
        <tattr name="output.pTouchDet" desc="For each pin: Touch detected" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.bvTdcTimeout" desc="Indicates TDC timeout error, one bit for each pin" type="hex" content="struct" scope="task" min="0000" max="ffff">0000</tattr>
        <tattr name="state.bvTdcValueOverflow" desc="Indicates TDC value overflow error, one bit for each pin" type="hex" content="struct" scope="task" min="0000" max="ffff">0000</tattr>
        <tattr name="state.genOutput" desc="Generate output after the current iteration?" type="dec" content="struct" scope="task" min="0" max="65535">1</tattr>
        <tattr name="state.pBaselineValue" desc="For each pin: Baseline value (expected TDC value when not touching)" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pHighValue" desc="For each pin: High value (expected TDC value when not touching)" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pLowMeanIirFilter" desc="For each pin: IIR-filtered mean value of the low mean window (used to update the baseline)" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="-32768" max="32767">0</tattr>
        <tattr name="state.pLowMeanWindow" desc="For each pin: Window of mean values of qualified TDC values while not touching" size="LOW_MEAN_WINDOW_TOTAL" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pTdcSmplLowCount" desc="For each pin: Number of low TDC samples in row, used to control baseline update" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pTdcSmplWindow" desc="For each pin: Window of the last qualified TDC values" size="TDC_SMPL_WINDOW_TOTAL" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pTdcTimeoutCount" desc="For each pin: Number of consecutive TDC timeouts" size="PIN_COUNT" type="expr" content="struct_array" scope="task" min="0" max="65535">MAX_TDC_TIMEOUTS - 1</tattr>
        <tattr name="state.pTouchDet" desc="For each pin: Touch currently detected" size="PIN_COUNT" type="dec" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.pTouchHoldCount" size="PIN_COUNT" type="expr" content="struct_array" scope="task" min="0" max="65535">0</tattr>
        <tattr name="state.smplPeriod" desc="Sample period [0.25 ms]" type="expr" content="struct" scope="task" min="0" max="65535">D_MIN_SMPL_PERIOD</tattr>
        <tattr name="state.startupIterCount" desc="Counts the number of task iterations performed during startup" type="dec" content="struct" scope="task" min="0" max="65535">0</tattr>
