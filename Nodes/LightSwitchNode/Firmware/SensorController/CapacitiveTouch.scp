        <sccode name="event0" init_power_mode="0"><![CDATA[// MACRO: Updates a first-order IIR filter
// acc = acc - (acc / 2^divExp) + (add / 2^divExp)
macro iirFilter(acc, add, divExp) {
    U16 accInt = acc << 1;
    accInt -= acc >> (divExp - 1);
    accInt += add >> (divExp - 1);
    acc = accInt >> 1;
}


// Acquire shared peripherals
fwAcquirePeripheral(PERIPHERAL_COMPA_ISRC);
fwAcquirePeripheral(PERIPHERAL_TDC);

// Enable COMPA, including 2 uA through internal 400 kOhm in parallel with external
// 1.2 MOhm = 0.6 V reference voltage for COMPA
compaEnableWithCapTouchRef();
compaSelectGpioRef(AUXIO_AXS_CAP_TOUCH_REF);

// Enable ISRC (set current from cfg register)
isrcEnable(cfg.isrcCurrent);

// Select 2 x 48 MHz from RCOSC_HF as TDC counter clock source
tdcSetCntSource(TDC_CNTSRC_96M_RCOSC);

// Enable the TDC with start trigger on ISRC reset release and stop trigger on COMPA
tdcSetTriggers(TDC_STARTTRIG_COMPA_HIGH, TDC_STOPTRIG_COMPA_HIGH, 1);
tdcEnable();

// For each pin ...
U16* pTdcSmplWindowPinBase = #state.pTdcSmplWindow;
U16* pLowMeanWindowPinBase = #state.pLowMeanWindow;
for (U16 n = 0; n < PIN_COUNT; n++) {

    // Select COMPA input/ISRC output
    compaSelectGpioInput(cfg.pAuxioAxdCapTouch[n]);

    // Prepare the TDC value window for inserting the new sample, start calculating
    // the mean value of the TDC value window
    U16* pTdcSmplItem = pTdcSmplWindowPinBase + (TDC_SMPL_WINDOW_SIZE - 2);
    U16 tdcSmplWindowMean = 0;
    while (pTdcSmplItem >= pTdcSmplWindowPinBase) {
        U16 tdcSmplItemValue = *(pTdcSmplItem++);
        *pTdcSmplItem = tdcSmplItemValue;
        pTdcSmplItem -= 2;
        tdcSmplWindowMean += tdcSmplItemValue;
    }

    // Prepare the TDC and trigger start of measurement
    tdcArm(TDC_START_ASYNC);
    isrcRelease(cfg.pAuxioAxdCapTouch[n]);

    // Wait for the COMPA output to go high, and then disconnect the internal 400 kOhm resistor.
    // This raises the COMPA referance voltage from 0.6 V to 2.4 V. Drive to VDDS for 1+ us to
    // ensure that the reference rises quickly, and then let it fall to 2.4 V.
    do {
        U16 compaValue;
        compaGetOutput(compaValue);
    } while (compaValue == 0);
    gpioSetOutput(AUXIO_AXS_CAP_TOUCH_REF);
    compaDisconnectCapTouchRefIntRes();
    fwDelayInstrCycles(12);
    gpioClearOutput(AUXIO_AXS_CAP_TOUCH_REF);

    // Wait for the TDC stop trigger with 100 us timeout
    U16 isTdcDone;
    tdcWaitUs(100);
    tdcCheckDoneEv(isTdcDone);

    // Re-clamp the pin to ground
    isrcClamp(cfg.pAuxioAxdCapTouch[n]);

    // Reconnect the internal 400 kOhm resistor. This returns the COMPA reference voltage to 0.6 V.
    compaConnectCapTouchRefIntRes();

    // Check whether the TDC measurement actually finished, and then read and store the TDC value
    U16 tdcValueL;
    U16 tdcValueH;
    tdcGetValue(tdcValueH, tdcValueL);
    output.pTdcValueRaw[n] = tdcValueL;

    // Handle TDC timeout: Reuse last value until MAX_TDC_TIMEOUTS timeouts in a row, then it's an error
    // For the very first iteration the timeout count is initialized to MAX_TDC_TIMEOUTS - 1
    U16 tdcTimeoutCount = state.pTdcTimeoutCount[n];
    if (isTdcDone == 1) {
        tdcTimeoutCount = 0;
    } else {
        tdcValueL = *pTdcSmplWindowPinBase;
        utilIncrAndSat(tdcTimeoutCount, MAX_TDC_TIMEOUTS; tdcTimeoutCount);
        if (tdcTimeoutCount == MAX_TDC_TIMEOUTS) {
            state.bvTdcTimeout |= 1 << n;
        }
    }
    state.pTdcTimeoutCount[n] = tdcTimeoutCount;

    // Handle TDC value overflow: Hard-limit so that arithmetic overflow cannot occur
    if (TDC_SMPL_WINDOW_EXP >= LOW_MEAN_WINDOW_EXP) {
        if (tdcValueL >= (0xFFFF >> TDC_SMPL_WINDOW_EXP)) {
            tdcValueL = 0xFFFF >> TDC_SMPL_WINDOW_EXP;
            state.bvTdcValueOverflow |= 1 << n;
        }
    } else {
        if (tdcValueL >= (0xFFFF >> LOW_MEAN_WINDOW_EXP)) {
            tdcValueL = 0xFFFF >> LOW_MEAN_WINDOW_EXP;
            state.bvTdcValueOverflow |= 1 << n;
        }
    }

    // Handle TDC value spikes: Saturate the TDC value to a range around the current baseline
    if (state.startupIterCount > TDC_SMPL_WINDOW_SIZE) {

        // The TDC value's maximum deviation from the baseline is 1.25 * (filterHighVal - baseline)
        U16 baselineValue = state.pBaselineValue[n];
        U16 highBaselineDiff = state.pHighValue[n] - baselineValue;

        // Ensure that the TDC value is in the range [baseline - margin, baseline + 2 * margin]
        U16 minTdcValueL = baselineValue - highBaselineDiff;
        U16 maxTdcValueL = baselineValue + (highBaselineDiff << 1);
        if (tdcValueL < minTdcValueL) {
            tdcValueL = minTdcValueL;
        } else if (tdcValueL > maxTdcValueL) {
            tdcValueL = maxTdcValueL;
        }
    }

    // Store the new TDC value
    *pTdcSmplWindowPinBase = tdcValueL;

    // Finalize the TDC value window mean
    tdcSmplWindowMean += tdcValueL;
    tdcSmplWindowMean >>= TDC_SMPL_WINDOW_EXP;
    output.pTdcSmplWindowMean[n] = tdcSmplWindowMean;

    // Each time the TDC value window has been replaced while not detecting a touch, add the
    // low TDC value window mean to the low mean window
    if (state.pTdcSmplLowCount[n] >= TDC_SMPL_WINDOW_SIZE) {
        ifnot (state.pTdcSmplLowCount[n] & (TDC_SMPL_WINDOW_SIZE - 1)) {

            // Shift the current low mean window, and calculate the mean value of the moved values
            U16* pLowMeanItem = pLowMeanWindowPinBase + (LOW_MEAN_WINDOW_SIZE - 2);
            U16 lowMeanWindowMean = 0;
            while (pLowMeanItem >= pLowMeanWindowPinBase) {
                U16 lowMeanItemValue = *(pLowMeanItem++);
                *pLowMeanItem = lowMeanItemValue;
                pLowMeanItem -= 2;

                // Add to the average, using the TDC value window mean for uninitialized entries
                if (lowMeanItemValue == 0) {
                    lowMeanWindowMean += tdcSmplWindowMean;
                } else {
                    lowMeanWindowMean += lowMeanItemValue;
                }
            }

            // Insert the new TDC value window mean, and finalize the sum
            *pLowMeanWindowPinBase = tdcSmplWindowMean;
            lowMeanWindowMean += tdcSmplWindowMean;
            lowMeanWindowMean >>= LOW_MEAN_WINDOW_EXP;

            // Calculate the low mean value by IIR filtering
            if (state.startupIterCount < LOW_MEAN_IIR_UPDATE_PERIOD) {
                state.pLowMeanIirFilter[n] = lowMeanWindowMean;
            } else {
                iirFilter(state.pLowMeanIirFilter[n], lowMeanWindowMean, LOW_MEAN_IIR_DIV_EXP);
            }
        }
    }

    // During initialization we do this for every iteration. This wastes a few cycles, but reduces complexity
    if (state.startupIterCount < TDC_SMPL_WINDOW_SIZE) {
        state.pTdcSmplLowCount[n] += 1;
        state.pBaselineValue[n] = tdcSmplWindowMean;
        state.pHighValue[n] = tdcSmplWindowMean + (tdcSmplWindowMean >> 5); // Baseline + 1/32

    // After initialization ...
    } else {

        // If not touched after the last measurement ...
        U16 baselineValue = state.pBaselineValue[n];
        U16 highValue = state.pHighValue[n];
        if (state.pTouchDet[n] == 0) {

            // Update the baseline after a backoff period
            U16 lowMeanIirFilter = state.pLowMeanIirFilter[n];
            if (state.pTdcSmplLowCount[n] > (LOW_MEAN_IIR_UPDATE_PERIOD + BASELINE_UPDATE_PERIOD)) {

                // The baseline value tracks faster when going down than when going up
                if (lowMeanIirFilter < baselineValue) {
                    iirFilter(baselineValue, lowMeanIirFilter, 1);
                } else {
                    iirFilter(baselineValue, lowMeanIirFilter, 3);
                }
                state.pBaselineValue[n] = baselineValue;

                // Back off
                state.pTdcSmplLowCount[n] -= BASELINE_UPDATE_PERIOD;
            }

        // Otherwise ...
        } else {

            // Update the high value
            iirFilter(highValue, tdcSmplWindowMean, 4);
        }
        output.pBaselineValue[n] = baselineValue;

        // Limit the high value to the range [baseline + 1/32, baseline + 1/4]
        U16 minHighValue = baselineValue + (baselineValue >> 5);
        if (highValue < minHighValue) {
            highValue = minHighValue;
        }
        U16 maxHighValue = baselineValue + (baselineValue >> 2);
        if (highValue > maxHighValue) {
            highValue = maxHighValue;
        }
        state.pHighValue[n] = highValue;
        output.pHighValue[n] = highValue;

        // Set the touch detection threshold to 1/2 between the baseline and the high value
        //U16 thresValue = baselineValue + ((highValue - baselineValue) >> 1);
        //output.pThresValue[n] = thresValue;

        // --- STAŁY offset nad śledzonym baseline + histereza ---
        // (adaptacyjny midpoint nie działał przez szkło: podłoga minHighValue
        //  wymuszała próg >= ~+28, a delta through-glass to ~+25)
        U16 thresValue;
        if (state.pTouchDet[n] != 0) {
            thresValue = baselineValue + TOUCH_RELEASE_OFFSET;  // zwolnij niżej
        } else {
            thresValue = baselineValue + TOUCH_DETECT_OFFSET;   // załącz wyżej
        }
        output.pThresValue[n] = thresValue;

        // Detect touch
     //   U16 touchDetNow;
     //   if (tdcSmplWindowMean > thresValue){
     //       touchDetNow = 1;
     //       state.pTdcSmplLowCount[n] = 0;
     //       state.smplPeriod = cfg.minSmplPeriod;
     //   } else {
     //       touchDetNow = 0;
     //       state.pTdcSmplLowCount[n] += 1;
     //   }

        // Detect touch
        U16 touchDetNow;
        if (tdcSmplWindowMean > thresValue){
            touchDetNow = 1;
            state.pTdcSmplLowCount[n] = 0;
            state.smplPeriod = cfg.minSmplPeriod;

            // Anti-stuck: "dotyk" dłuższy niż realny palec (> MAX_TOUCH_ITERATIONS)
            // to skok środowiskowy, nie palec -> przeskocz baseline i zwolnij.
            state.pTouchHoldCount[n] += 1;
            if (state.pTouchHoldCount[n] > MAX_TOUCH_ITERATIONS) {
                state.pBaselineValue[n] = tdcSmplWindowMean;
                state.pTouchHoldCount[n] = 0;
                touchDetNow = 0;
            }
        } else {
            touchDetNow = 0;
            state.pTdcSmplLowCount[n] += 1;
            state.pTouchHoldCount[n] = 0;
        }

        // Find whether we should generate any output
        if (touchDetNow != state.pTouchDet[n]) {
            state.pTouchDet[n] = touchDetNow;
            state.genOutput = 1;
        } else {
            state.genOutput |= touchDetNow;
        }
        output.pTouchDet[n] = touchDetNow;
    }

    // Move on to the next window of TDC samples
    pTdcSmplWindowPinBase += TDC_SMPL_WINDOW_SIZE;
    pLowMeanWindowPinBase += LOW_MEAN_WINDOW_SIZE;
}

// Disable COMPA, ISRC and TDC
tdcDisable();
isrcDisable();
compaDisable();

// Release shared peripherals
fwReleasePeripheral(PERIPHERAL_COMPA_ISRC);
fwReleasePeripheral(PERIPHERAL_TDC);

// If filter initialization has not been done ...
U16 smplPeriod = state.smplPeriod;
if (state.startupIterCount < 100) {
    state.startupIterCount += 1;

    // Set minimum sampling period
    smplPeriod = cfg.minSmplPeriod;

// Otherwise ...
} else {

    // Ensure that the sampling period is not less than the minimum (for example while tuning)
    U16 minSmplPeriod = cfg.minSmplPeriod;
    if (smplPeriod < minSmplPeriod) {
        smplPeriod = minSmplPeriod;
    }

    // Increase the sample period, slowly at first and then faster until reaching the maximum.
    // When touch is detected, the sampling period is set back to the minimum below.
    smplPeriod += ((smplPeriod - minSmplPeriod) >> 4);
    U16 maxSmplPeriod = cfg.maxSmplPeriod;
    if (smplPeriod < maxSmplPeriod) {
        smplPeriod += 1;
    } else {
        smplPeriod = maxSmplPeriod;
    }
}
state.smplPeriod = smplPeriod;

// Always generate output during run-time logging
U16 logMask;
rtlGetLogMask(logMask);
if (logMask != 0) {
    state.genOutput = 1;
}

// Indicate errors
output.bvTdcTimeout = state.bvTdcTimeout;
output.bvTdcValueOverflow = state.bvTdcValueOverflow;

// Generate output:
// - While touch is detected
// - When touch detection ends
// - Every time during run-time logging
if (state.genOutput != 0) {
    fwSwitchOutputBuffer();
    state.genOutput = 0;

    // Run-time logging
    rtlLogStructs(BV_RTL_LOG_OUTPUT | BV_RTL_LOG_STATE);
}

// Schedule the next execution
evhSetupTimer1Trigger(0, state.smplPeriod, 0);]]></sccode>
        <sccode name="event1" init_power_mode="0"><![CDATA[]]></sccode>
        <sccode name="event2" init_power_mode="0"><![CDATA[]]></sccode>
        <sccode name="event3" init_power_mode="0"><![CDATA[]]></sccode>
        <sccode name="execute" init_power_mode="0"><![CDATA[]]></sccode>
        <sccode name="initialize" init_power_mode="0"><![CDATA[// Clamp all capactive touch pins to ground
for (U16 n = 0; n < PIN_COUNT; n++) {
    isrcClamp(cfg.pAuxioAxdCapTouch[n]);
}

// Do not drive the reference high
gpioClearOutput(AUXIO_AXS_CAP_TOUCH_REF);

// Schedule the first execution
evhSetupTimer1Trigger(0, 1, 5);]]></sccode>
        <sccode name="terminate" init_power_mode="0"><![CDATA[// Stop triggering the event handler code
evhCancelTrigger(0);]]></sccode>
        <event_trigger active_count="1">0,1,2,3</event_trigger>
        <tt_iter>run_event0</tt_iter>
        <tt_struct>output.pTdcValueRaw.[0],output.pTdcValueRaw.[1],output.pTouchDet.[0],output.pTouchDet.[1],state.pLowMeanIirFilter.[0],state.pTdcSmplLowCount.[0],state.pTouchHoldCount.[0]</tt_struct>
        <rtl_struct>output.pTdcValueRaw.[0],output.pTouchDet.[0],output.pTouchDet.[1]</rtl_struct>
        <rtl_task_sel en="1" struct_log_list="output"/>
        <rtl_cfg_slider name="ISRC Current" struct_member="cfg.isrcCurrent" min="1" max="63" value="4"><![CDATA[value = (slider << 2) | 0x01;]]></rtl_cfg_slider>
        <tt_child_graph name="Baseline" parent_struct_member="output.pTdcValueRaw" child_struct_member="output.pBaselineValue" parent_array_index="0" child_array_index="0" scaling_factor="1" scaling_offset="0"/>
        <tt_child_graph name="Threshold" parent_struct_member="output.pTdcValueRaw" child_struct_member="output.pThresValue" parent_array_index="0" child_array_index="0" scaling_factor="1" scaling_offset="0"/>
        <tt_child_graph name="High" parent_struct_member="output.pTdcValueRaw" child_struct_member="output.pHighValue" parent_array_index="0" child_array_index="0" scaling_factor="1" scaling_offset="0"/>
        <tt_child_graph name="TdcSmplMean" parent_struct_member="output.pTdcValueRaw" child_struct_member="output.pTdcSmplWindowMean" parent_array_index="0" child_array_index="0" scaling_factor="1" scaling_offset="0"/>
    </task>
</project>
