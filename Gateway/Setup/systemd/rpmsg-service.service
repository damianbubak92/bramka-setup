[Unit]
Description=RPMsg Bridge Service (Linux <-> M4F)
Documentation=https://github.com/damianbubak92/bramka-setup
After=network.target
# Czekaj na M4F remoteproc zanim wystartujesz - jeśli M4F nie running,
# OpenTransport nie znajdzie /dev/rpmsg* i service padnie od razu.
# (cold-boot race obsłużony w transport.go: waitForM4FChrdev czeka do 20s)

# Safety net - jeśli serwis pada >3 razy w 60s, systemd przestaje restartować.
# MUSI być w [Unit] (w [Service] nowoczesny systemd to ignoruje!).
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=notify
# Production service mode: serve (phone HTTPS API + WS + engine time-sync + rule push
# + node telemetry -> DB + recovery). NOT a crash test despite the -test flag name.
# Backup/restore endpoint URLs + key come from /etc/bramka/rpmsg.env (gitignored -
# NEVER put the key in this unit, it is committed). The `-` makes the file optional;
# the -flag=${VAR} form is empty-safe (missing file -> backup simply disabled, serve
# still runs). Create the file on the gateway (root:bramka 0640):
#   BACKUP_URL=http://iot.aitronic.pl/gw-backup.php
#   RESTORE_URL=http://iot.aitronic.pl/gw-restore.php
#   BACKUP_KEY=<secret>
EnvironmentFile=-/etc/bramka/rpmsg.env
# Self-heal DB ownership before start. If serve/import/restore was ever run
# interactively as root, SQLite's -wal/-shm (or the dir) flip to root and the
# bramka user then hits "attempt to write a readonly database" -> no HTTP/WS API.
# '+' runs as root (bypassing User=bramka + sandbox) so this can chown. Idempotent.
ExecStartPre=+/bin/sh -c 'chown -R bramka:bramka /var/lib/bramka'
ExecStart=/opt/bramka/rpmsg-service/rpmsg-service -test serve -db /var/lib/bramka/bramka.db -backup-url=${BACKUP_URL} -restore-url=${RESTORE_URL} -backup-key=${BACKUP_KEY}
WorkingDirectory=/opt/bramka/rpmsg-service

# === NON-ROOT (least privilege) ===
# Patrz modules/08-hardening.sh: user 'bramka' + udev (/dev/rpmsg* -> grupa bramka)
# + path-unit dla czystego reboota (serwis nie ma roota ani CAP_SYS_BOOT).
User=bramka
Group=bramka

# === RESTART POLICY ===
# on-failure (NIE always!) - restartuj tylko gdy crash/non-zero exit.
Restart=on-failure
RestartSec=2

# === WATCHDOG ===
# systemd zabije serwis SIGABRT jeśli nie wyśle WATCHDOG=1 w ciągu 10s.
# Go service kickuje co 5s (WATCHDOG_USEC/2). Działa też jako non-root (sd_notify).
WatchdogSec=10s

# === TIMEOUTS ===
TimeoutStartSec=30s
TimeoutStopSec=15s

# === LOGGING ===
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpmsg-service

# === SECURITY HARDENING ===
# Zero capabilities - serwis nic nie potrzebuje (device przez grupę, reboot przez
# path-unit, stan przez ReadWritePaths). NIE ustawiać PrivateDevices - musi widzieć
# /dev/rpmsg. NIE ustawiać MemoryDenyWriteExecute - może wadzić Go/cgo.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
# PrivateTmp: DELIBERATELY OFF. It needs /var/tmp (-> /var/volatile/tmp on Arago)
# to exist at namespace-setup time, but /var/volatile is a tmpfs and the OS
# volatile/tmpfiles ordering intermittently leaves /var/volatile/tmp missing after
# a boot -> systemd fails the whole unit with "spawn start-pre: Not a directory"
# (ENOTDIR). That took the entire gateway offline for 3 days (2026-08-17). The
# isolation gain on a single-service non-root appliance is marginal; reliability
# wins. Do NOT re-enable without a guaranteed /var/volatile/tmp (e.g. a oneshot
# ordered After=var-volatile.mount Before=this unit).
# PrivateTmp=true
# /run/bramka is on tmpfs and was ALSO intermittently missing after a boot (same
# Yocto volatile/tmpfiles fragility) -> ReadWritePaths=/run/bramka would ENOTDIR
# the unit too. RuntimeDirectory= makes systemd create it as part of THIS unit's
# start (immune to tmpfiles ordering); Preserve=yes keeps it across restarts so the
# bramka-reboot.path (watching /run/bramka/reboot-request) is unaffected.
RuntimeDirectory=bramka
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/bramka /run/bramka
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
